# ==============================================================================
# simply todo - Environment Variables Template (.env.example)
# ==============================================================================
# Repository: todo-db
# License: Apache 2.0
# Instructions: Copy this file, rename it to '.env', and replace the placeholder 
#               values below with your own local development credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database User Configuration
# ------------------------------------------------------------------------------
# Define the superuser account name for the PostgreSQL database.
POSTGRES_USER=your_local_username_here

# ------------------------------------------------------------------------------
# 2. Database Password Configuration
# ------------------------------------------------------------------------------
# Define the secure password for the superuser account.
# No spaces or special characters that might break Docker YAML parsing.
POSTGRES_PASSWORD=your_local_password_here

# ------------------------------------------------------------------------------
# 3. Database Name Configuration
# ------------------------------------------------------------------------------
# Define the target database name. Default recommendation is 'tododb'.
POSTGRES_DB=tododb
